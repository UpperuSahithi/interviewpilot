generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

model User {
  id        String   @id @default(cuid())

  clerkId   String   @unique

  name      String?
  email     String   @unique
  image      String?

  createdAt DateTime @default(now())

  interviews Interview[]
}

model Interview {
  id          String   @id @default(cuid())
  category    String
  difficulty  String
  score       Int?
  createdAt   DateTime @default(now())

  userId      String
  user        User @relation(fields: [userId], references: [id])
}